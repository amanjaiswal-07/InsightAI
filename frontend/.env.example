# Backend URL. Leave empty to use the Vite dev proxy (npm run dev) or when the
# backend serves the built UI itself (single-container deploy).
VITE_API_BASE_URL=

# Only needed if the backend has API_KEYS set. Must match one of those keys.
# Anything in a VITE_ variable ends up in the browser bundle, so it is not secret.
VITE_API_KEY=
