# Copy to .env and fill in. Only GROQ_API_KEY is required.

# ── Required ─────────────────────────────────────────────────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.1
MAX_TOKENS=2048
# Per-request timeout (seconds) and retries for 429 / 5xx / timeouts
LLM_TIMEOUT=60
LLM_MAX_RETRIES=5

# ── API protection ───────────────────────────────────────────────────────────
# Comma-separated keys accepted in the X-Api-Key header. Leave empty to disable
# auth for local development. If set, put the same key in frontend/.env as
# VITE_API_KEY (note: a key built into a public frontend is visible to users).
API_KEYS=
# Allowed browser origins (comma-separated). "*" is fine for local use.
CORS_ORIGINS=*
# Maximum size of a single uploaded file
MAX_UPLOAD_MB=25

# ── Storage (paths are created on startup) ──────────────────────────────────
DB_PATH=./data/business.db
CHAT_DB_PATH=./data/chat_history.db
VECTOR_STORE_PATH=./data/vector_stores
CSV_TABLE_PREFIX=upload_
ENABLE_HYBRID_CSV=True

# ── RAG models (downloaded from Hugging Face on first run) ───────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Optional Redis cache for chat history (falls back to in-process fakeredis)
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
